# Copie para .env na VPS e preencha. O .env NUNCA vai para o git.
#   cp .env.example .env && nano .env && chmod 600 .env

# --- Imagens ---------------------------------------------------------------
# Dono dos pacotes no GitHub Container Registry (seu usuário do GitHub).
GHCR_OWNER=matheusenc
# Deixe em latest no dia a dia. Para voltar atrás, use o sha de um build
# anterior, ex.: sha-1a2b3c4 (veja em github.com/<voce>/<repo>/pkgs/container).
API_TAG=latest
WEB_TAG=latest

# --- Banco -----------------------------------------------------------------
POSTGRES_DB=hsjdb
POSTGRES_USER=hsj
# openssl rand -base64 24
POSTGRES_PASSWORD=

# --- JWT -------------------------------------------------------------------
# openssl rand -base64 48   (mínimo 32 bytes; trocar invalida todos os tokens)
JWT_SIGNING_KEY=
JWT_EXPIRATION_MINUTES=60

# --- Primeiro admin (criado pelo DatabaseSeeder no primeiro boot) -----------
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@hsjnovaera.com.br
# Troque a senha pelo painel depois do primeiro login: o valor fica em texto
# plano neste arquivo.
SEED_ADMIN_PASSWORD=

# --- CORS ------------------------------------------------------------------
# Origem do site. Sem barra no final — o backend compara string exata.
CORS_ORIGIN_SITE=https://hsjnovaera.com.br

# --- TLS -------------------------------------------------------------------
# E-mail que a Let's Encrypt usa para avisar de expiração.
ACME_EMAIL=
